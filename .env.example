# This tool is offline by default and needs no configuration file.
#
# These settings only apply if you turn on optional AI drafting, and even then
# the UI and CLI flags take precedence. The key is never written to disk by the
# application itself.

OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
